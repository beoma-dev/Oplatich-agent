# Секреты и окружение
.env
# Окружение стенда: в нём токен второго бота. Шаблон .env.stage.example —
# в репозитории, сам файл — никогда.
.env.stage
secrets/
# JSON по умолчанию — секрет (ключи сервис-аккаунта, выгрузки), исключения
# перечисляем явно.
*.json
!requirements*.json
!package.json
!package-lock.json

# Данные (реестр, файлы счетов, справочник пользователей)
data/
data-stage/
storage/
dist/

# Настройки конкретной установки: домен стенда — как и .env, не в репозитории
deploy/conf.d/*.caddy

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Node: зависимости тестов Mini App ставит npm ci
node_modules/

# Логи и временные файлы
*.log
downloads/
.DS_Store
