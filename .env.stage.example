# Окружение СТЕНДА. Копия .env, в которой разведено всё, что не должно
# пересекаться с боевым контуром. Скопируйте в .env.stage и заполните.
#
#   cp .env.stage.example .env.stage && chmod 600 .env.stage
#
# Всё, что здесь НЕ задано, берётся из значений по умолчанию config.py —
# боевой .env стенд не читает.

# --- Обязательно своё ---------------------------------------------------------
# Отдельный бот в BotFather (/newbot). Тот же токен, что у боевого, работать
# не будет: два опроса одного бота конфликтуют.
TELEGRAM_BOT_TOKEN=

# Поддомен стенда с A-записью на этот же сервер. Caddy выпустит сертификат сам.
WEBAPP_URL=https://stage.invoice.example.com/
# Тот же домен без схемы — его подставит deploy/conf.d/stage.caddy.
# Задаётся в общем .env рядом с DOMAIN: STAGE_DOMAIN=stage.invoice.example.com

# Плашка над формой. Пока она непустая, спутать стенд с боевым невозможно.
ENV_LABEL=СТЕНД
ORG_NAME=Оплатыч · СТЕНД

# --- Главное правило безопасности --------------------------------------------
# Карточки заявок со стенда НЕ должны попадать настоящим финансистам.
# Здесь только тестовый чат или ваш собственный id.
FINANCE_CHAT_IDS=

# Кто может подавать заявки на стенде и кто им управляет — обычно вы один.
ALLOWED_USER_IDS=
ADMIN_IDS=

# --- Выход в Telegram ---------------------------------------------------------
# Тот же прокси, что у боевого: контейнер общий, память не дублируется.
PROXY_URL=socks5://warp:1080

# --- Хранилище ----------------------------------------------------------------
# Только local: Google-таблицу боевого реестра стенд трогать не должен.
STORAGE_BACKEND=local

# --- Необязательное -----------------------------------------------------------
# Короткое имя Mini App у СТЕНДОВОГО бота (BotFather → /newapp).
MINIAPP_SHORT_NAME=
# Бэкап стенда никому не нужен — пусто выключает расписание.
BACKUP_TIME=

# --- Поведение: держать таким же, как в бою ---
# Стенд без этих ключей падал на умолчания, и совпадение с боевым было
# случайным. ORG_INN вообще пустовал — а по нему автозаполнение отличает
# нашу сторону от контрагента, то есть логика на стенде вела себя иначе.
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
DEDUP_WINDOW_DAYS=14
ORG_INN=
REMINDERS_ENABLED=true
REMINDER_TIME=09:30
BACKUP_KEEP=7
INVOICE_AUTOFILL=true

# Прокси у стенда СВОЙ (сервис warp-stage). Общий с боевым отбирал у стенда
# смысл в самом опасном месте: правку прокси нельзя было отрепетировать —
# пересоздание общего контейнера роняло оба контура разом.
PROXY_URL=socks5://warp-stage:1080
TELEGRAM_PINNED_IP=149.154.167.220
