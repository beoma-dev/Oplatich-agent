# ==== Telegram ====
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Финансисты: получают карточку КАЖДОЙ заявки с кнопками статуса
# (✅ Оплачено / ⏸ Отложено / ❌ Отклонено), PDF-документом и файлом счёта.
# Можно @username ИЛИ числовой id, через запятую. Пусто = карточки не уходят.
# ВАЖНО: чтобы бот мог написать финансисту по @username, тот должен сначала сам
# написать боту (/start) или быть с ботом в общей группе — иначе Telegram не даст
# отправить ему личное сообщение.
# Дополнять список можно из Telegram (админ-панель ⚙️ в форме или /fin_add).
FINANCE_CHAT_IDS=@financist

# Whitelist сотрудников, которым разрешено подавать заявки (user_id через запятую).
# FAIL-CLOSED: пустой список = доступ закрыт для ВСЕХ (кроме админов из ADMIN_IDS).
# Дополнять список можно из Telegram (админ-панель ⚙️ или /allow).
ALLOWED_USER_IDS=

# Справочник СБ «id:ФИО» через запятую: в реестр попадает подтверждённое ФИО,
# а не имя из Telegram-профиля (его пользователь может сменить на что угодно).
# EMPLOYEE_NAMES=969015071:Елипашев Павел,123456:Иванов Иван

# Админы бота: могут управлять финансистами и whitelist прямо из Telegram —
# через панель ⚙️ в Mini App или команды /admin, /fin_add, /allow и т.д.
# Числовые id через запятую (свой id подскажет команда /myid).
ADMIN_IDS=

# ==== Mini App / HTTPS ====
# Публичный HTTPS-адрес формы Mini App (страница webapp/).
# Пусто = мини-приложение выключено, бот работает пошаговой чат-формой.
WEBAPP_URL=https://invoice.example.com/

# Короткое имя Mini App, зарегистрированного в @BotFather командой /newapp
# (Web App URL там = WEBAPP_URL). Если задано — кнопка в группе/канале
# открывает форму ПРЯМО поверх чата (t.me/<бот>/<имя>?startapp=...), без
# перехода в личку. Пусто = кнопка ведёт в личку с ботом.
MINIAPP_SHORT_NAME=

# Домен для Caddy (docker compose). A-запись домена должна указывать на сервер.
DOMAIN=invoice.example.com

# Где слушает встроенный HTTP API (за реверс-прокси).
# В docker compose переопределяется на 0.0.0.0 автоматически.
API_HOST=127.0.0.1
API_PORT=8080

# ==== Сеть ====
# Прокси для api.telegram.org, если он недоступен с сервера (типично для части
# российских хостеров: таймаут на getMe при старте). SOCKS5 или HTTP.
# Пусто = прямое подключение.
# Бесплатный вариант — sidecar Cloudflare WARP из docker-compose.yml:
# PROXY_URL=socks5://warp:1080
# Свой прокси:
# PROXY_URL=socks5://user:pass@host:port
# PROXY_URL=http://host:port
# Можно НЕСКОЛЬКО через запятую — при старте бот проверит их по порядку
# коротким getMe и подключится через первый отвечающий (запасной канал
# на случай смерти WARP; см. DEPLOY.md «Запасной прокси»):
# PROXY_URL=socks5://warp:1080,socks5://user:pass@backup-host:1080
PROXY_URL=

# ==== Хранилище ====
# Бэкенд реестра и файлов счетов:
#   local  — CSV-реестр + каталог на сервере (по умолчанию, ничего не требует);
#   google — Google Sheets + Google Drive (нужен service account, см. README).
STORAGE_BACKEND=local

# --- Google (для STORAGE_BACKEND=google) ---
# JSON-ключ service account. Положите в secrets/ — каталог в .gitignore.
GOOGLE_CREDENTIALS_FILE=secrets/service_account.json
# ID таблицы и папки «Счета» — из их URL. ОБЕ должны быть расшарены на email
# service account (…@…iam.gserviceaccount.com) с правом «Редактор».
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- Локальное хранилище ---
# Каталог, куда сохраняются файлы счетов. По умолчанию — ./storage внутри
# каталога проекта. В docker compose переопределяется на /data/storage.
# STORAGE_DIR=/opt/invoice-bot/storage

# Имя xlsx-реестра (создаётся внутри STORAGE_DIR) или абсолютный путь.
# Формат — шаблон «Реестр.xlsx» из ТЗ. Старое значение *.csv автоматически
# трактуется как *.xlsx (CSV упразднён).
REGISTRY_FILE=registry.xlsx

# Только для STORAGE_BACKEND=google: локальное xlsx-зеркало Google-таблицы
# (реестр + статусы дублируются в файл; он же отдаётся командой /export).
# Относительный путь — внутри STORAGE_DIR.
# REGISTRY_XLSX_FILE=Реестр.xlsx

# ==== Безопасность ====
# Автопроверка вложения «похоже ли на счёт»: текст PDF + OCR (Tesseract в
# Docker). Мягкая: не блокирует подачу, а предупреждает автора и финансиста
# и пишет событие в аудит. 0 = выключить.
INVOICE_CHECK=1

# Окно поиска дублей заявки в днях: если за это время уже подавалась заявка
# с теми же контрагентом/суммой/валютой/статьёй/датой — бот попросит
# подтверждение перед отправкой. 0 = проверка выключена.
DEDUP_WINDOW_DAYS=14
# SQLite аудит-журнала и отпечатков дедупа (в Docker: /data/security.db).
# SECURITY_DB_FILE=data/security.db

# Ежедневный автобэкап данных (реестр, файлы счетов, SQLite, настройки):
# время ЧЧ:ММ в TIMEZONE, архив уходит админам в Telegram. Пусто = выключен.
# Это ДЕФОЛТЫ: включение/время/число копий меняются из админ-панели ⚙️
# без рестарта. Ручной запуск — /backup или кнопка «💾 Сейчас» в панели.
BACKUP_TIME=03:30
# Сколько последних архивов хранить в data/backups.
BACKUP_KEEP=7

# Бета: по приложенному счёту бот распознаёт сумму, контрагента и реквизиты
# и ПРЕДЛАГАЕТ заполнить ими форму. Сам ничего не заполняет — решает человек.
# 0 = выключить совсем. Тумблер есть и в админ-панели ⚙️ (без рестарта).
INVOICE_AUTOFILL=1

# ==== Напоминания о сроках оплаты ====
# Раз в сутки бот присылает финансистам сводку «скоро к оплате», а по
# просрочке — отдельную сводку (кому именно, настраивается).
# Значения ниже — только значения ПО УМОЛЧАНИЮ: горизонт предупреждения,
# получателей просрочки и расписание админ правит в панели ⚙️ → «Напоминания
# финансистам», и они применяются без рестарта.
REMINDERS_ENABLED=1
# Время ежедневной рассылки (ЧЧ:ММ, в TIMEZONE).
REMINDER_TIME=09:30

# ==== Прочее ====
# Название организации — печатается в шапке PDF-документа заявки.
ORG_NAME=DEVMOPS


# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Часовой пояс для меток времени в реестре
TIMEZONE=Europe/Moscow
