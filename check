#!/usr/bin/env bash
# Full local/CI check. Optional groups are partial checks, never a full pass.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
PYTHON="${PYTHON:-python3}"
if [[ -z "${VIRTUAL_ENV:-}" && -x .venv/bin/python && "$PYTHON" == python3 ]]; then
  PYTHON="$PWD/.venv/bin/python"
fi

case "${1:-all}" in
  all|python|web|image) ;;
  *) echo "Usage: ./check [all|python|web|image]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo "Expected at most one group" >&2; exit 2; }
"$PYTHON" tools/shared_standards.py check
python_checks() {
  "$PYTHON" -m pip_audit -r requirements.txt
  "$PYTHON" -m ruff check .
  "$PYTHON" -m pytest -q
  TELEGRAM_BOT_TOKEN=dummy:token "$PYTHON" -c 'import main, api.server, api.routes, bot.handlers, services.intake'
}
web_checks() {
  npm ci
  npm test
  npx playwright install chromium
  npm run test:e2e
}
image_checks() { "$PYTHON" tools/check_image.py; }
case "${1:-all}" in
  all) python_checks; web_checks; image_checks ;;
  python) python_checks ;;
  web) web_checks ;;
  image) image_checks ;;
esac
