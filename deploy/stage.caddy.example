# Сайт стенда. Скопируйте в deploy/conf.d/stage.caddy — боевой Caddyfile
# подхватывает всё из этого каталога по маске. Пока файла нет, стенда для
# Caddy не существует (маска без совпадений — не ошибка, проверено
# `caddy validate`).
#
# STAGE_DOMAIN приходит из .env рядом с DOMAIN: например
# STAGE_DOMAIN=stage.invoice.example.com
#
# Значение по умолчанию (stage.localhost) стоит НЕ для красоты: пустая
# переменная дала бы пустой адрес сайта, а от него Caddy падает целиком —
# вместе с боевым сайтом. Забыли переменную — стенд просто не открывается.
{$STAGE_DOMAIN:stage.localhost} {
	request_body {
		max_size 25MB
	}
	encode zstd gzip
	reverse_proxy stage:8080
}
