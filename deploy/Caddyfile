# Реверс-прокси с автоматическим HTTPS (Let's Encrypt).
# DOMAIN приходит из окружения (docker-compose.yml → .env).
{$DOMAIN} {
	# Файл счёта до 20 МБ + поля формы; с запасом.
	request_body {
		max_size 25MB
	}
	# Сжатие статики. Без него Mini App тянул 276 КБ на каждое открытие:
	# app.js и app.css отдаются без изменений, а сжимаются вчетверо.
	encode zstd gzip

	reverse_proxy app:8080
}

# Дополнительные сайты этой установки (стенд). Пока в каталоге нет ни одного
# .caddy — маска не совпадает ни с чем, и это НЕ ошибка: проверено
# `caddy validate`. Боевой контур от появления и исчезновения стенда
# не зависит.
import /etc/caddy/conf.d/*.caddy
